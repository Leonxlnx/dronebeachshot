{
  "kind": "scene-memory-cleanup-source-audit",
  "createdAt": "2026-10-01T07:59:03.863595+00:00",
  "scope": "Two bounded startup resource cleanups; no browser/GPU execution or running-film modification by this audit.",
  "threeVersion": "0.185.1",
  "changes": [
    {
      "name": "Private GLTF orphan ImageBitmap disposal",
      "ownership": "Opt-in only for createVegetation private complete loads; parser is not reused for image loading. Generic and cache-enabled callers do not dispose.",
      "releasePoint": "After every awaited lookup and source rebinding has succeeded. Close each displaced ImageBitmap identity once only if no current scene texture, canonical pool Source, or direct Cache entry retains it.",
      "failureBehavior": "No closure after a failed lookup or rebind. Canonical images survive pool.clear. A different Source or unassociated scene texture referencing the same bitmap protects it.",
      "estimate": {
        "duplicateEmbeddedImageEntries": 18,
        "uniqueEncodedImages": 38,
        "rgba8BackingBytes": 75497472,
        "MiB": 72,
        "derivation": "18 byte-identical duplicate 1024 x 1024 image entries x 4 RGBA8 bytes. Full encoded-byte equality verified after SHA-256 matching. Native allocation/RSS not measured."
      },
      "runtimeEvidenceAvailable": "closedBitmaps and closedBitmapPixels diagnostics; no full-scene result collected for this change yet."
    },
    {
      "name": "Unused near-ocean normal and UV attributes",
      "ownership": "36 static noncasting near-ocean tiles use the custom world-position shader; water normals are analytic. No normal/UV/depth-caster consumer in the reviewed path.",
      "releasePoint": "Delete only normal and uv attributes before the first renderer upload, after existing positions, indices and bounds have been built.",
      "estimate": {
        "tiles": 36,
        "verticesPerTile": 22801,
        "totalVertices": 820836,
        "bytesPerNormalAndUVVertex": 20,
        "cpuAttributeBytes": 16416720,
        "cpuAttributeMiB": 15.656204223632812,
        "possibleAdditionalGpuAttributeBytes": 16416720,
        "possibleCpuPlusGpuMiB": 31.312408447265625,
        "gpuCaveat": "Three uploads every retained geometry attribute when that geometry is submitted. GPU saving depends on which tiles were uploaded; this is an upper bound for all 36."
      },
      "visualInvariant": "All 36 position/index arrays and bounding boxes/spheres match the unpruned reference exactly; original XZ triangle coverage and winding test also passes."
    }
  ],
  "verification": {
